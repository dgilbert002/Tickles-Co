# =====================================================================
# LLM GATEWAY — pick one provider; that block's settings auto-apply
# =====================================================================
LLM_GATEWAY_DEFAULT=openrouter          # openrouter | requesty

# ---- openrouter block (active when LLM_GATEWAY_DEFAULT=openrouter) ----
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
OPENROUTER_TEMPERATURE=0.1

# ---- requesty block (active when LLM_GATEWAY_DEFAULT=requesty) ----
REQUESTY_API=rqsty-sk-...
REQUESTY_API_KEY=                        # alias of REQUESTY_API
REQUESTY_BASE_URL=https://router.requesty.ai/v1
TICKLES_APP_REQUESTY_URL=                # alias of REQUESTY_BASE_URL
REQUESTY_DEFAULT_MODEL=tickles-vision
REQUESTY_FALLBACK_MODEL=google/gemini-2.5-flash
REQUESTY_TEMPERATURE=0.1

# Per-service overrides (optional — leave commented to inherit DEFAULT)
# LLM_GATEWAY_INTERPRETATION=openrouter
# LLM_GATEWAY_MCP=openrouter
# LLM_GATEWAY_GURU=openrouter
# LLM_GATEWAY_VISION=openrouter
# LLM_GATEWAY_PREFILTER=openrouter
# LLM_GATEWAY_TEXT_EXTRACT=openrouter
# LLM_GATEWAY_POSTMORTEM=openrouter

# Per-service model overrides (optional)
# CHART_HACKER_MODEL_INTERPRETATION_PRIMARY=anthropic/claude-sonnet-4
# CHART_HACKER_MODEL_INTERPRETATION_FALLBACK=google/gemini-2.0-flash-001
# CHART_HACKER_MODEL_MCP_PRIMARY=anthropic/claude-sonnet-4
# CHART_HACKER_MODEL_MCP_FALLBACK=google/gemini-2.0-flash-001

# Legacy vision aliases (also covered above)
TICKLES_APP_VISION_API_KEY=
TICKLES_APP_VISION_API_MODEL=tickles-vision
TICKLES_APP_PRE_VISION_API_MODEL=google/gemini-2.5-flash

# [Q] Cost-log master switch — default ON
LLM_COST_LOG_ENABLED=true
API_COST_LOG_ENABLED=true

# [BP] LLM anomaly detection — loop / burst thresholds
LLM_LOOP_WINDOW_SECONDS=300
LLM_LOOP_IDENTICAL_THRESHOLD=3
LLM_LOOP_SIMILAR_THRESHOLD=5
LLM_FREQUENCY_BURST_THRESHOLD=10

# [BP] Soft / hard daily budget thresholds (USD)
LLM_BUDGET_USD_DAILY_SOFT=50.0
LLM_BUDGET_USD_DAILY_HARD=200.0

