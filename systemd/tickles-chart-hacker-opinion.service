[Unit]
Description=Tickles ChartHacker Opinion Service (Phase 8 — open-position vision opinions)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tickles
EnvironmentFile=-/opt/tickles/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/tickles
Environment=OPINION_GLOBAL_BUDGET_PER_HOUR=120
Environment=OPINION_GLOBAL_BUDGET_USD_PER_DAY=10.0
Environment=OPINION_PER_POSITION_PER_HOUR=2
Environment=OPINION_MIN_CONFIDENCE=0.45
# Gemini 3 Flash reasoning models burn ~8K tokens on internal thought before any
# visible output. 8192 was too low — finish_reason=length + truncated JSON + retry storm.
# 32768 leaves ~24K visible after reasoning overhead.
Environment=OPINION_MAX_TOKENS=32768
ExecStart=/usr/bin/python3 -m shared.scripts.run_chart_hacker_opinion
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/tickles/chart_hacker_opinion.log
StandardError=append:/var/log/tickles/chart_hacker_opinion.log
SyslogIdentifier=tickles-chart-hacker-opinion

[Install]
WantedBy=multi-user.target
